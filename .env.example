# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Needed for payments, orders and admin.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Payments: "paystack" or "flutterwave" ----
PAYMENT_GATEWAY=paystack

# Paystack TEST keys (dashboard > Settings > API Keys & Webhooks). Starts with sk_test_
PAYSTACK_SECRET_KEY=

# Flutterwave TEST keys (dashboard > Settings > API). Secret key is used for payments.
FLUTTERWAVE_SECRET_KEY=
# Any random string you choose. Paste the same value in Flutterwave's webhook "Secret hash".
FLUTTERWAVE_SECRET_HASH=

# ---- SMM provider (leave empty to use the built-in mock provider) ----
PROVIDER_API_URL=
PROVIDER_API_KEY=
